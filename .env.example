# ---- Database (PostgreSQL) ----
# Use any Postgres provider (Neon, Supabase, Railway, local). Free option: https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/orbit?schema=public"

# ---- Admin auth ----
# Change these. Password is hashed on seed; secret signs the session cookie.
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="orbit-admin-123"

# ---- Image storage (optional) ----
# If set, uploads go to Cloudinary. If unset, files save to /public/uploads (dev fallback).
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL="cloudinary://xxxxx:yyyyy@your-cloud"

# ---- Meta (Facebook) Pixel ----
# From Meta Events Manager. Enables ad conversion tracking + retargeting.
# NEXT_PUBLIC_META_PIXEL_ID="1234567890"
